#!/usr/bin/env bash
# Kill stalled interactive agent-unlock prompts (ssh-add / pinentry / ssh-askpass)
# that are holding the keychain lock, then remove any stale lock files.
#
# Usage:
#   keychain-unstick              # show holders, kill with SIGTERM, clear stale locks
#   keychain-unstick -9           # SIGKILL instead of SIGTERM
#   keychain-unstick -n           # dry-run: show what would be killed, do nothing
#   keychain-unstick -r           # after cleanup, re-source ~/.keychain/${HOST}-sh

set -u

SIG=TERM
DRY=0
RESOURCE=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -9|--kill)  SIG=KILL ;;
    -n|--dry)   DRY=1 ;;
    -r|--reload) RESOURCE=1 ;;
    -h|--help)
      sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

PATTERN='ssh-add|pinentry|ssh-askpass'

echo "==> holders (lock files + matching processes)"
shopt -s nullglob
locks=( ~/.keychain/*.lock )
if (( ${#locks[@]} )); then
  lsof "${locks[@]}" 2>/dev/null || true
else
  echo "  (no lock files present)"
fi
pgrep -afl -u "$USER" "$PATTERN" || echo "  (no matching processes)"

if (( DRY )); then
  echo "==> dry-run: not killing"
  exit 0
fi

echo "==> sending SIG${SIG} to ${PATTERN} (user: $USER)"
pkill -"$SIG" -u "$USER" -f "$PATTERN" && echo "  killed" || echo "  nothing to kill"

# Give the OS a moment to release file handles before unlinking the lock.
sleep 0.2

echo "==> clearing stale lock files"
host_short=$(hostname -s 2>/dev/null || hostname)
for f in ~/.keychain/"${host_short}"-sh.lock ~/.keychain/"${host_short}".lock; do
  [[ -e $f ]] && rm -f "$f" && echo "  removed $f"
done

if (( RESOURCE )); then
  src=~/.keychain/"${host_short}"-sh
  if [[ -r $src ]]; then
    echo "==> sourcing $src"
    # shellcheck disable=SC1090
    . "$src"
  else
    echo "  (no $src to source)" >&2
  fi
fi
